---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { liveSite, postDetails } from '../posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => b.id.localeCompare(a.id));
  return posts.map((post) => ({
    params: { path: postDetails(post).path },
    props: { post, related: posts.filter((entry) => entry.id !== post.id) },
  }));
}

interface Props { post: CollectionEntry<'posts'>; related: CollectionEntry<'posts'>[] }
const { post, related } = Astro.props;
const details = postDetails(post);
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const outline = headings.filter(({ depth }) => depth >= 2 && depth <= 3);
const curated = (remarkPluginFrontmatter.recommendedPosts ?? []) as { href: string; title: string }[];
const available = related.map((entry) => ({
  href: postDetails(entry).href, title: entry.data.title, category: entry.data.category[0],
}));
const used = new Set([details.href]);
const curatedLinks = curated.flatMap(({ href, title }) => {
  const url = new URL(href, new URL(details.href, liveSite));
  const path = url.pathname.endsWith('/') ? url.pathname : `${url.pathname}/`;
  const isBlog = url.origin === liveSite;
  const key = isBlog ? path : url.href;
  if (used.has(key)) return [];
  used.add(key);
  const local = isBlog ? available.find((entry) => entry.href === path) : undefined;
  return [{ href: local ? `${local.href}${url.search}${url.hash}` : url.href, title, category: local?.category ?? '추천 글' }];
});
const relatedLinks = [...curatedLinks, ...available.filter(({ href }) => !used.has(href)).slice(0, 2)];
---
<Base page="article" title={post.data.title} description={details.summary ?? post.data.title}>
  <main id="main" class="shell article-shell">
    <a class="back-link text-link" href="/#latest"><span aria-hidden="true">←</span> 최신 글로 돌아가기</a>
    <article class="article-grid" data-pagefind-body>
      <header class="article-header">
        <p class="eyebrow"><span class="signal"></span> ENGINEERING NOTES</p>
        <h1 class="page-title" data-pagefind-meta="title">{post.data.title}</h1>
        <p class="article-summary">{details.summary}</p>
        <div class="article-info">
          <span>강준현</span>
          <time datetime={details.date}>{details.label}</time>
        </div>
        <ul class="taxonomy" aria-label="카테고리 및 태그">
          {post.data.category.map((category) => <li data-pagefind-filter="category">{category}</li>)}
          {post.data.tags?.map((tag) => <li data-pagefind-filter="tag">{tag}</li>)}
        </ul>
      </header>
      <aside class="desktop-outline" data-pagefind-ignore>
        <nav class="outline" aria-label="글 목차">
          <p class="eyebrow">ON THIS PAGE</p>
          <ul>
            {outline.map(({ slug, text, depth }) => <li class:list={{ nested: depth === 3 }}><a href={`#${slug}`}>{text}</a></li>)}
          </ul>
        </nav>
      </aside>
      <div class="article-column">
        <details class="mobile-outline" data-pagefind-ignore>
          <summary>이 글의 목차</summary>
          <nav class="outline" aria-label="글 목차">
            <ul>
              {outline.map(({ slug, text, depth }) => <li class:list={{ nested: depth === 3 }}><a href={`#${slug}`}>{text}</a></li>)}
            </ul>
          </nav>
        </details>
        <div class="prose"><Content /></div>
        <p class="sr-only" role="status" id="copy-status" data-pagefind-ignore></p>
        {relatedLinks.length > 0 && <section class="article-end" aria-labelledby="related-title" data-pagefind-ignore>
          <p class="eyebrow">KEEP READING</p>
          <h2 id="related-title">함께 읽으면 좋은 글</h2>
          <ul class="related" id={curated.length ? 'recommend-posts-before-this' : undefined}>
            {relatedLinks.map(({ href, title, category }) => (
              <li><a href={href}><span><span class="entry-meta">{category}</span>{title}</span></a></li>
            ))}
          </ul>
        </section>}
        <section class="article-end" aria-labelledby="discussion-title" data-pagefind-ignore>
          <p class="eyebrow">DISCUSSION</p>
          <h2 id="discussion-title">댓글</h2>
          <p>이 글에 대한 질문과 의견은 운영 사이트의 댓글에서 이어갈 수 있습니다.</p>
          <a class="text-link" href={`${liveSite}${details.href}#utterances-comments`}>기존 댓글 보기 <span aria-hidden="true">↗</span></a>
        </section>
      </div>
    </article>
  </main>
</Base>
<script>
  const status = document.querySelector('#copy-status');
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((block) => {
    const code = block.querySelector('code');
    if (!code) return;
    const frame = document.createElement('div');
    frame.className = 'code-frame';
    block.before(frame);
    frame.append(block);

    const button = document.createElement('button');
    button.className = 'copy-button';
    button.type = 'button';
    button.textContent = '복사';
    button.setAttribute('aria-label', '코드 복사');
    frame.prepend(button);

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.textContent = '복사됨';
        if (status) status.textContent = '코드를 복사했습니다.';
      } catch {
        button.textContent = '다시 복사';
        if (status) status.textContent = '코드를 복사하지 못했습니다.';
      }
      window.setTimeout(() => { button.textContent = '복사'; }, 1800);
    });
  });
</script>
