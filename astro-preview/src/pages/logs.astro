---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MenuIntro from '../components/MenuIntro.astro';
import { liveSite } from '../posts';

const logs = (await getCollection('logs', ({ data }) => !data.hidden))
  .sort((a, b) => b.id.localeCompare(a.id))
  .map(({ id, data }) => ({
    year: id.slice(0, 4),
    date: id.split('/')[1].slice(0, 10),
    title: data.title,
    href: `${liveSite}/logs/${id}/`,
  }));
const years = [...new Set(logs.map(({ year }) => year))];
const description = '프로젝트와 커리어, 일상에서 남긴 회고를 연도별로 모았습니다.';
---
<Base page="logs" title="Logs" description={description}>
  <main id="main" class="shell">
    <MenuIntro kicker="RETROSPECTIVES" description={description}>Logs</MenuIntro>
    <div class="archive-grid">
      <aside class="archive-sidebar">
        <h2>연도별 회고</h2>
        <nav class="log-years" aria-label="회고 연도">
          {years.map((year) => <a class="text-link" href={`#year-${year}`}>{year}</a>)}
        </nav>
      </aside>
      <div class="archive-list">
        <p class="eyebrow archive-count">{logs.length}개 글</p>
        {years.map((year) => (
          <section class="archive-year" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`}>{year}</h2>
            <ul class="entries">
              {logs.filter((log) => log.year === year).map(({ date, title, href }) => (
                <li>
                  <time class="entry-meta" datetime={date}>{date.replaceAll('-', '.')}</time>
                  <h3><a href={href}>{title}<span class="entry-arrow" aria-hidden="true">↗</span></a></h3>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </main>
</Base>
